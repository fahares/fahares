# Fahares backup configuration — copy to /etc/fahares-backup/backup.env (owner: the host user that runs the backup, mode 600).
# Every value except the secrets below has a sensible default in fahares-backup.sh.

# --- Telegram (private channel; a dedicated backup bot, NOT the Hermes bot) ---
TG_BOT_TOKEN=
TG_CHAT_ID=                 # e.g. -1001234567890
# TG_API_BASE=https://api.telegram.org

# --- Encryption for Telegram copies (public key only; the private key stays offline) ---
AGE_RECIPIENT=              # age1...

# --- Google Drive via restic + rclone ---
RESTIC_REPOSITORY=rclone:gdrive:fahares-restic
RESTIC_PASSWORD_FILE=/etc/fahares-backup/restic.pass
# RCLONE_CONFIG=$HOME/.config/rclone/rclone.conf

# --- Database (auto-detected from Coolify labels when DB_CONTAINER is empty) ---
# DB_CONTAINER=
# DB_NAME=default
# DB_CONTAINER_LABELS="coolify.projectName=fahares coolify.type=database"
# APP_CONTAINER_LABELS="coolify.projectName=fahares coolify.type=application"
# DB_IGNORE_DATA="cache cache_locks sessions jobs job_batches failed_jobs"
# KEY_TABLES="users field_suggestions scholarly_annotations entity_redirects manuscripts works people"

# --- Paths and retention ---
# WORK_DIR=/var/backups/fahares        # local copies (plain .sql.zst, mode 600)
# STATE_DIR=/var/lib/fahares-backup     # last.json, readable by the hermes user
# MEDIA_DIR=$HOME/fahares_storage
# LOCAL_KEEP=3
# KEEP_DAILY=14
# KEEP_WEEKLY=8
# KEEP_MONTHLY=12
# MAX_AGE_HOURS=30
# ZSTD_LEVEL=10
# CHUNK_SIZE=19M                        # bot getFile downloads are limited to 20 MB
# CONFIG_FILES="/etc/fahares-backup/backup.env"

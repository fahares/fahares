#!/usr/bin/env bash
# Make a database dump for a collaborator's local site, from the local copy of production (`fahares_prod` in the
# `fahares_mariadb` container), without the private data. Runs on the owner's machine only.
#
#   scripts/dev/dev-dump <output.sql.zst>
#
# What the dump holds:
#   - the structure of every table;
#   - the data of the catalogue itself (works, manuscripts, people, sources, page texts, …) and of the public pages;
#   - `users` with the ids, roles and dates kept and everything else replaced (name, email, password, phone, Google
#     and Telegram ids, avatar), so that rows pointing at a user still resolve;
#   - `field_suggestions` without guest names and emails, held credit names and admin notes;
#   - no rows at all for the tables in EMPTY below: sessions, devices, tokens, messages, notifications, the audit log,
#     visit and search logs, queues and cache.
#
# A new table that holds private data must be added to EMPTY (or cleaned like `users`) before the next dump.
set -euo pipefail

out="${1:?usage: dev-dump <output.sql.zst>}"
DB="${FAHARES_DUMP_DB:-fahares_prod}"
TMP="${DB}_devdump_tmp"
CONTAINER="${FAHARES_DB_CONTAINER:-fahares_mariadb}"

EMPTY=(sessions password_reset_tokens known_devices push_subscriptions notifications notification_preferences
    messages message_threads message_attachments announcement_user audit_logs page_views search_logs
    cache cache_locks jobs job_batches failed_jobs)
CLEANED=(users field_suggestions)

sql() { docker exec -i "$CONTAINER" sh -c 'exec mariadb -uroot -p"$MARIADB_ROOT_PASSWORD" "$@"' sh "$@"; }
dump() { docker exec "$CONTAINER" sh -c 'exec mariadb-dump -uroot -p"$MARIADB_ROOT_PASSWORD" --single-transaction --quick --skip-lock-tables --no-tablespaces "$@"' sh "$@"; }

trap 'sql -e "DROP DATABASE IF EXISTS \`$TMP\`"' EXIT
sql <<SQL
DROP DATABASE IF EXISTS \`$TMP\`;
CREATE DATABASE \`$TMP\`;
CREATE TABLE \`$TMP\`.users LIKE \`$DB\`.users;
INSERT INTO \`$TMP\`.users SELECT * FROM \`$DB\`.users;
UPDATE \`$TMP\`.users SET
    name = CONCAT('کاربر ', id), email = CONCAT('user', id, '@example.test'), google_id = NULL, password = '!',
    affiliation = NULL, phone = NULL, telegram_chat_id = NULL, avatar_path = NULL, avatar_source = NULL,
    remember_token = NULL;
CREATE TABLE \`$TMP\`.field_suggestions LIKE \`$DB\`.field_suggestions;
INSERT INTO \`$TMP\`.field_suggestions SELECT * FROM \`$DB\`.field_suggestions;
UPDATE \`$TMP\`.field_suggestions SET guest_name = NULL, guest_email = NULL, held_credit_name = NULL, admin_notes = NULL;
SQL

ignore=()
for t in "${EMPTY[@]}" "${CLEANED[@]}"; do ignore+=("--ignore-table=$DB.$t"); done

{
    dump --no-data "$DB"
    dump --no-create-info "${ignore[@]}" "$DB"
    dump --no-create-info "$TMP" "${CLEANED[@]}"
} | zstd -T0 -10 -q -o "$out" -f

ls -lh "$out"
